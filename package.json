{
  "name": "ethoko",
  "description": "Monorepo for Ethoko packages and applications, warehouse for smart contract compilation artifacts.",
  "author": "Loïc Vincent-Genod",
  "homepage": "https://github.com/VGLoic/ethoko",
  "bugs": {
    "url": "https://github.com/VGLoic/ethoko/issues"
  },
  "private": true,
  "keywords": [
    "web3",
    "ethereum",
    "smart contracts",
    "hardhat",
    "foundry",
    "plugin",
    "infrastructure"
  ],
  "scripts": {
    "validate:central": "node scripts/validate.mjs central",
    "validate:cli": "node scripts/validate.mjs cli",
    "test:validation": "node --test scripts/validation.test.mjs",
    "test:integration:db:start": "node scripts/integration-db.mjs start",
    "test:integration:db:status": "node scripts/integration-db.mjs status",
    "test:integration:db:stop": "node scripts/integration-db.mjs stop",
    "test:integration:db:clean": "node scripts/integration-db.mjs clean",
    "test:integration:db:test": "node --test scripts/integration-db.test.mjs",
    "playground:explore": "node scripts/central-playground.mjs explore",
    "playground:start": "node scripts/central-playground.mjs start",
    "playground:status": "node scripts/central-playground.mjs status",
    "playground:stop": "node scripts/central-playground.mjs stop",
    "playground:reset": "node scripts/central-playground.mjs reset",
    "playground:clean": "node scripts/central-playground.mjs clean",
    "playground:browser:install": "pnpm exec playwright install chromium",
    "test:playground": "node --test scripts/central-playground.test.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test:unit": "turbo run test:unit",
    "test:e2e:core": "pnpm --filter @ethoko/cli-beacon test:e2e",
    "test:e2e:apps": "turbo run test:e2e:apps",
    "test:e2e:ui": "pnpm --filter central-ui test:e2e",
    "test:integration": "pnpm --filter central test:integration",
    "lint": "turbo run lint",
    "lint:ci": "turbo run lint:ci",
    "format": "turbo run format",
    "check-format": "turbo run check-format",
    "check-types": "turbo run check-types",
    "check-types:ci": "turbo run check-types:ci",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@playwright/mcp": "0.0.83",
    "playwright": "1.64.0-alpha-1790635538000",
    "prettier": "^3.7.4",
    "turbo": "^2.8.0",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bun"
    ]
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  }
}
