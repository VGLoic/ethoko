# REQUIRED
# The URL of the server
SELF_URL=

# REQUIRED
# The URL of the web application
WEB_APP_URL=

# REQUIRED
# SECRET shared with Central UI BFF, sent as Authorization Bearer credential
CENTRAL_UI_BFF_SHARED_SECRET=

# Server port
PORT=

# Application log level, this variable has priority over `RUST_LOG`
LOG_LEVEL=

# REQUIRED
# SECRET
# Format is `postgresql://<Postgres user>:<Postgres password>@<Postgres host>:<Postgres port>/<Postgres DB>`
# For local database in compose.yaml: postgresql://admin:admin@localhost:5432/central
DATABASE_URL=postgresql://admin:admin@localhost:5432/central

# REQUIRED
# SECRET
RESEND_API_KEY=

# REQUIRED
# The GitHub OAuth client setup
GITHUB_OAUTH_CLIENT_ID=
# SECRET
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
GITHUB_OAUTH_AUTH_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_AUTH_TOKEN_URL=https://github.com/login/oauth/access_token

# The TTL (time-to-live) for OAuth transactions in seconds
OAUTH_TRANSACTION_TTL_SECONDS=600

# The base URL for the GitHub API
GITHUB_API_URL=https://api.github.com
