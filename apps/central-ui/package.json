{
  "name": "central-ui",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "check-types": "react-router typegen && tsc",
    "check-types:ci": "react-router typegen && tsc",
    "check-format": "prettier --check --ignore-unknown 'app/**/*.{ts,tsx,css}'",
    "format": "prettier --write 'app/**/*.{ts,tsx,css}'",
    "lint": "eslint 'app/**/*.{ts,tsx,css}'"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^9.39.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.3"
  }
}
