{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playground": {
        "type": "local",
        "command": ["pnpm", "exec", "playwright-mcp"],
        "disabled": true
      }
    }
  },
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    {
      "action": "provider.use",
      "resource": "github-copilot",
      "effect": "allow"
    }
  ],
  "agents": {
    "smoke-coordinator": {
      "description": "Delegate the Copilot smoke message and publish its test comment",
      "mode": "primary",
      "model": "{env:SMOKE_MODEL}",
      "steps": 12,
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "copilot-smoke", "effect": "allow" },
        {
          "action": "subagent",
          "resource": "smoke-message",
          "effect": "allow"
        },
        { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
        { "action": "shell", "resource": "gh pr comment *", "effect": "allow" },
        {
          "action": "shell",
          "resource": "gh api repos/*/issues/comments/*",
          "effect": "allow"
        }
      ]
    },
    "smoke-message": {
      "description": "Prepare one short smoke-test message; return text only",
      "mode": "subagent",
      "model": "{env:SMOKE_MODEL}",
      "system": "Return a short test message identifying the exact model and reasoning variant supplied by the coordinator. This is a delegation smoke test, not a code review. Return text only.",
      "steps": 1,
      "permissions": [{ "action": "*", "resource": "*", "effect": "deny" }]
    }
  }
}
