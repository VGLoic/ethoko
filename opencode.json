{
  "$schema": "https://opencode.ai/config.json",
  "experimental.disable_paste_summary": true,
  "permissions": [
    { "action": "shell", "resource": "pnpm *", "effect": "allow" },
    { "action": "shell", "resource": "cargo test *", "effect": "allow" },
    { "action": "shell", "resource": "cargo check *", "effect": "allow" },
    { "action": "shell", "resource": "cargo clippy *", "effect": "allow" },
    { "action": "shell", "resource": "cargo build *", "effect": "allow" },
    { "action": "shell", "resource": "cargo fmt *", "effect": "allow" }
  ],
  "providers": {
    "lmstudio": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:1234"
      },
      "models": {
        "qwen/qwen3.5-9b": {
          "name": "Qwen 3.5-9B (local)",
          "limit": {
            "context": 100000,
            "output": 5000
          }
        }
      }
    }
  }
}
